{
  "name": "varj_rocq (Rocq 9.2)",
  "build": {
    "dockerfile": "Dockerfile",
    // The official Rocq images are amd64-only; on Apple Silicon they run under emulation.
    "options": ["--platform=linux/amd64"]
  },
  "runArgs": ["--platform=linux/amd64"],
  "remoteUser": "rocq",
  "customizations": {
    "vscode": {
      "extensions": ["rocq-prover.vsrocq"]
    }
  }
}
